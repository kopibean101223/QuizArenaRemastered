                    {speedMode && (
                    <div style={{ display:"flex", alignItems:"center", gap:5,
                        background:"rgba(255,201,60,0.15)", border:"1.5px solid rgba(255,201,60,0.35)",
                        borderRadius:20, padding:"5px 12px" }}>
                        <Zap size={13} fill={C.yellow} color="transparent" />
                        <span style={{ fontFamily:"Manrope, sans-serif", fontSize:12, fontWeight:800,
                        color:C.yellow, letterSpacing:"0.05em" }}>SPEED MODE</span>
