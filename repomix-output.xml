          >
            Return to Dashboard
          </button>
        </div>
      </div>
    );
  }

  const handleGameOver = async () => {
    // API call logic from previous attempt
    try {
      await fetch('/api/quiz-results', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          session_id: sessionId,
          user_id: socketCtx?.userId,
          score: internalScore,
          correct_answers: Math.max(0, internalStage - 1),
          total_questions: internalStage - 1 + (3 - internalLives),
          accuracy: internalStage > 1 ? Math.round(((internalStage - 1) / ((internalStage - 1) + 3)) * 100) : 0,
        })
      });
    } catch (err) {
      console.error(err);
    }
  };

  if (internalLives <= 0) {
    if (!alreadyPlayed) {
      handleGameOver();
      setAlreadyPlayed(true); // Prevent multi-calls
