        supabase.from('quiz_results')
          .select('id')
          .eq('session_id', sessionId)
          .eq('user_id', socketCtx.userId)
          .maybeSingle()
          .then(({ data }) => {
            if (data) {
              setAlreadyPlayed(true);
              setInternalLives(0); // Force game over screen immediately
            }
