  { id: "individual", label: "Individual", emoji: "⚡", desc: "Go solo and climb the leaderboard on your own skills." },
  { id: "team", label: "Team Battle", emoji: "🛡️", desc: "Join forces! Balanced teams compete for collective glory." },
