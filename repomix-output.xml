      if (!currentProfId) return;
      const { data } = await supabase
        .from('quiz_sessions')
        .select('*')
        .eq('professor_id', currentProfId)
        .eq('is_live', false)
        .in('status', ['PENDING', 'ACTIVE', 'COMPLETED'])
