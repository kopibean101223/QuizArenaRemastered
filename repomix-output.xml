      e.mode.toLowerCase().includes(search.toLowerCase());

    const matchesFilter =
      activeFilters.length === 0 ||
      activeFilters.includes(e.mode) ||
      activeFilters.includes(e.subject);

    return matchesSearch && matchesFilter;
  });

