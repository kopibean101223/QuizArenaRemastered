function enterBattle(code: string, sid: string, rawMode: string | null | undefined) {
  setRoomCode(code);
  setSessionId(sid);
  setMode(normalizeMode(rawMode));
  setActiveSectionId(sid);
  setHasJoined(true);
  localStorage.setItem(STORAGE_KEY, JSON.stringify({ code, sid, mode: rawMode }));
