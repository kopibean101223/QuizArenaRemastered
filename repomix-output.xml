//         <BattleSocketProvider
//           sessionId={sessionId}
//           userId={user?.id}
//           userName={user?.username || user?.user_metadata?.full_name || user?.email?.split('@')[0]}
//         >
//           <Lobby_LiveQuiz sessionId={sessionId} roomCode={roomCode} />
//         </BattleSocketProvider>
//       );
