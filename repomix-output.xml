function GeneratePanel({ 
  docs, 
  onGenerate, 
  generating 
}: { 
  docs: SyllabusDoc[]; 
  onGenerate: (config: { count: string; qtypes: string[]; docId: number | "all" }) => void; 
  generating: boolean;
