    return Math.round((count / teamMemberAnswers.length) * 100);
  };

  const handleSendChat = (text: string) => {
    send({
      type: 'TEAM_CHAT_MESSAGE',
      battleId,
      userId: memberId,
      teamId,
      sender: memberName,
