        wsRef.current.send(JSON.stringify({
          type: 'ADVANCE_QUESTION',
          battleId: sessionId,
          currentIndex: nextIdx,
          nextTimeLimit: 60,
          isLastQuestion: false,
          customQuestion: customQ
        }));
      }
      setTimeRemaining(60);
      setTimeout(() => setIsAdvancing(false), 500);
