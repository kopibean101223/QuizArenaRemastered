                {/* Logo + Q number */}
                <div style={{ display:"flex", alignItems:"center", gap:10, flexShrink:0 }}>
                    <div style={{ width:36, height:36, borderRadius:11, background:C.indigo,
                    display:"flex", alignItems:"center", justifyContent:"center",
                    boxShadow:"0 3px 12px rgba(91,61,246,0.4)" }}>
                    <Trophy fill={C.yellow} color="transparent" size={18} />
                    </div>
                    <div>
                    <p style={{ fontFamily:"Fredoka, sans-serif", fontSize:13, fontWeight:600,
                        color:"rgba(255,255,255,0.5)", margin:0, lineHeight:1 }}>Question</p>
                    <p style={{ fontFamily:"Fredoka, sans-serif", fontSize:19, fontWeight:700,
