                    </div>
                </div>
                </div>

                {/* ── DISCUSSION MODE PANEL ── */}
                {mode === "discussion" && (
                <div style={{ height:220, background:"rgba(0,0,0,0.3)",
                    borderTop:"1.5px solid rgba(255,255,255,0.07)",
                    display:"flex", gap:0, flexShrink:0, animation:"slideDown 0.3s ease-out" }}>

                    {/* Chat feed */}
                    <div style={{ flex:1, display:"flex", flexDirection:"column",
                    borderRight:"1.5px solid rgba(255,255,255,0.06)", overflow:"hidden" }}>
