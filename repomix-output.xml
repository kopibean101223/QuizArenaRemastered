            ? 'bg-[var(--gm-indigo)] text-white shadow-[0_4px_20px_rgba(91,61,246,0.4)] hover:scale-105 active:scale-95 cursor-pointer animate-[gm-slide-down_0.3s_ease-out_1.3s_both]'
