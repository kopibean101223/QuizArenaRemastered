                {/* Unified Bulk Action Buttons Container */}
                <div style={{ display: "flex", gap: 7, flexWrap: "wrap" }}>
                  <button
                    type="button"
                    onClick={() => handleBulkStatusChange("approved")}
                    disabled={counts.pending === 0}
                    style={{
                      display: "inline-flex",
                      alignItems: "center",
