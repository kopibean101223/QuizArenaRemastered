    if (!user) return;
    setLoading(true);
    const mine = await fetchMySections(supabase, user.id);
    setSections(mine);
    setLoading(false);
  }

  useEffect(() => { loadSections(); }, [user?.id]);

  async function handleJoin() {
    if (!user) return;
    setJoining(true);
    const res = await joinSectionByCode(supabase, user.id, joinCode);
    setJoining(false);
