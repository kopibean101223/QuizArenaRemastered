  console.log('[BattleSync Input] Full Raw Payload:', JSON.stringify(data, null, 2));
  console.log('====================================================================\n');

  try {
    // FIX: battleId is indeed the quiz_sessions.id!
    const sessionUpdatePayload = {
      status: 'COMPLETED',
      finished_at: new Date().toISOString(),
      mode: battleMode
    };
