    feedEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  function sendFreeText() {
    const trimmed = input.trim();
    if (!trimmed) return;
    onSend(trimmed);
    setInput("");
  }

  const heading = title ?? (mode === "free" ? "Team Chat" : "Match Chat");

  return (
    <div
      style={{
        display: "flex",
        flexDirection: "column",
        height,
        background: "rgba(0,0,0,0.2)",
