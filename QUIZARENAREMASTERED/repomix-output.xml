  return (
    <span style={{ display:"inline-flex",alignItems:"center",gap:3,
      background:bg, borderRadius:20, padding:"3px 9px" }}>
      {flat ? <Minus size={11} color={col} strokeWidth={2.5}/> :
       up   ? <TrendingUp size={11} color={col} strokeWidth={2.5}/> :
