    metadata jsonb,
    score float
)
LANGUAGE sql
AS $$
WITH vector_search AS (
    SELECT
        dc.id,
        dc.content,
        dc.metadata,
        1 - ((dc.embedding::halfvec(3072)) <=> (query_embedding::halfvec(3072))) AS similarity_score,
        row_number() OVER (ORDER BY (dc.embedding::halfvec(3072)) <=> (query_embedding::halfvec(3072))) AS vector_rank
    FROM
