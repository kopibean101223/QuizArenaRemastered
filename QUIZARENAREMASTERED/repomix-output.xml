                    if (!updated.some(p => p.id === hs.id || p.name === hs.name)) {
                      hs.avatarColor = AVATAR_COLORS[updated.length % AVATAR_COLORS.length];
                      updated.push(hs);
                    }
                  });
                  return updated;
                });
              }
