    END IF;
END $$;

-- ═══════════════════════════════════════════════════════════════════════
-- 4. Create/update the hybrid search RPC v2 (with document_chunks FTS)
-- ═══════════════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION match_document_chunks_v2(
    query_text text,
    query_embedding vector,
    match_count int DEFAULT 10,
    filter_doc_id text DEFAULT ''
)
RETURNS TABLE (
    id uuid, 
