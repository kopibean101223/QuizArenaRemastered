                      </div>
                    ) : (
                      <div style={{ display: "flex", alignItems: "flex-start", gap: 6, color: C.red, fontSize: 12, fontFamily: "Manrope, sans-serif", fontWeight: 600, lineHeight: 1.4 }}>
