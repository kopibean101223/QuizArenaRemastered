                <input
                  value={nameInput}
                  onChange={(e) => setNameInput(e.target.value)}
                  autoFocus
                  style={{
                    fontFamily: "Fredoka, sans-serif", fontSize: 18, fontWeight: 700, color: "#fff",
                    background: "rgba(255,255,255,0.07)", border: "1.5px solid rgba(255,255,255,0.15)",
