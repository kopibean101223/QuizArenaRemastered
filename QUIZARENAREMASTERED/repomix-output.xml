          if (data?.status === 'ACTIVE') {
            enterBattle(parsed.code, parsed.sid, parsed.mode);
          } else {
            localStorage.removeItem(STORAGE_KEY);
          }
        }
      } catch (e) {
        localStorage.removeItem(STORAGE_KEY);
