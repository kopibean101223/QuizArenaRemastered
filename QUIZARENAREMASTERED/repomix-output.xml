                         <div style={{flex: 1}}>
                            <span style={{fontSize: 11, fontWeight: 700, color: C.muted, display: "block", marginBottom: 2}}>Expected Output</span>
                            <span style={{fontFamily: "monospace", fontSize: 13, color: C.navy}}>{tc.expectedOutput}</span>
                         </div>
                      </div>
                   ))}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

