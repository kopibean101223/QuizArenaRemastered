const prisma = new PrismaClient();

async function main() {
  try {
    const docs = await prisma.syllabusDoc.findMany({
      orderBy: { id: 'desc' },
      take: 1
    });
    console.log('Docs success:', docs);
    
    const questions = await prisma.generatedQuestion.findMany({
